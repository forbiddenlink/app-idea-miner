# Dockerfile for Celery Worker Service
FROM python:3.12-slim@sha256:02108f5d322dd89f1c9e552442c25acb0543dfdbc455693a5599624f20d9155d

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    gcc \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Install UV
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"

# Set working directory
WORKDIR /app

# Copy workspace configuration
COPY pyproject.toml uv.lock ./
COPY apps/worker/pyproject.toml ./apps/worker/
COPY packages/core/pyproject.toml ./packages/core/

# Install dependencies
# --no-cache: the uv download cache otherwise stays in this layer and roughly doubles it.
RUN uv sync --frozen --all-packages --no-cache

# Copy application code
COPY apps/worker ./apps/worker
COPY packages ./packages

# Default command (can be overridden in docker-compose)
CMD ["uv", "run", "celery", "-A", "apps.worker.celery_app", "worker", "--loglevel=info"]
