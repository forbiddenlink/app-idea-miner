# App-Idea Miner Environment Configuration
# Copy this file to .env and update values as needed

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/appideas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=appideas

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=info
API_KEY=dev-api-key

# Frontend Configuration (Vite)
# Leave VITE_API_URL empty for same-origin deployment (Vercel)
# Set to http://localhost:8000 only if running frontend separately from API
VITE_API_URL=
VITE_API_KEY=dev-api-key

# Worker Configuration
CELERY_WORKERS=2

# Data Sources
RSS_FEEDS=https://hnrss.org/newest
FETCH_INTERVAL_HOURS=6

# Clustering Configuration
MIN_CLUSTER_SIZE=3
MAX_FEATURES=500
RECLUSTER_THRESHOLD=100

# Security (change in production!)
SECRET_KEY=change-me-in-production

# Notion Ideas Pipeline sink (optional - clustering runs fine without it)
# Leave NOTION_API_KEY empty to disable the sink entirely (fails open).
NOTION_API_KEY=
NOTION_IDEAS_DB_ID=
NOTION_MIN_QUALITY=0.6

# -----------------------------------------------------------------------------
# Variables read by the code that were missing above (names only, no values).
# Lines left as "# NAME=" are commented on purpose: an empty value would
# override the code default (or fail to parse), so set them only when needed.
# -----------------------------------------------------------------------------

# Anthropic API key for LLM idea extraction. Read at packages/core/nlp.py:143.
# Optional: only used when USE_LLM_EXTRACTION is true.
ANTHROPIC_API_KEY=
# Turn on LLM extraction (1, true or yes). Read at packages/core/nlp.py:125 and apps/worker/tasks/processing.py:77. Optional.
USE_LLM_EXTRACTION=
# Turn on embedding generation (1, true or yes). Read at packages/core/nlp.py:72. Optional.
GENERATE_EMBEDDINGS=
# Use sentence embeddings in clustering (1, true or yes). Read at packages/core/clustering.py:810. Optional.
USE_SENTENCE_EMBEDDINGS=
# Use BERTopic in clustering (1, true or yes). Read at packages/core/clustering.py:812. Optional.
USE_BERTOPIC=

# Reddit app credentials. Read at apps/worker/sources/reddit.py:25-26.
# Optional: without both, the Reddit source runs in a mock mode that is refused at ingestion.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit user agent string. Read at apps/worker/sources/reddit.py:27. Optional (default AppIdeaMiner/0.1.0).
# REDDIT_USER_AGENT=

# Product Hunt API token. Read at apps/worker/sources/producthunt.py:22. Optional.
PRODUCT_HUNT_TOKEN=

# Comma-separated App Store app IDs to mine. Read at apps/worker/sources/appstore.py:43. Optional.
APPSTORE_APP_IDS=
# App Store country code. Read at apps/worker/sources/appstore.py:45. Optional (default us).
# APPSTORE_COUNTRY=

# Extra competitor names, comma-separated. Read at packages/core/competitors.py:331. Optional.
COMPETITOR_LIST_EXTRA=
# Ideas included in the weekly digest. Read at apps/worker/tasks/weekly_digest.py:165. Optional.
WEEKLY_DIGEST_SIZE=

# Upstash Redis URL (rediss://...), preferred over REDIS_URL when set.
# Read at apps/api/app/config.py:36 and packages/core/cache.py:197. Optional.
UPSTASH_REDIS_URL=

# Set to 1 to disable the database connection pool. Read at packages/core/database.py:60. Optional.
DB_DISABLE_POOL=

# Runtime environment name; "production" enforces strong API_KEY and SECRET_KEY.
# Read at apps/api/app/config.py:19 (default development). Optional.
# ENV=production
# Trust X-Forwarded-* headers for rate limiting. Read at apps/api/app/config.py:22 (default true). Optional.
# TRUST_PROXY_HEADERS=true
# Deny requests when Redis is down instead of allowing them. Read at apps/api/app/config.py:26 (default false). Optional.
# RATE_LIMITER_FAIL_CLOSED=false
# JWT signing algorithm. Read at apps/api/app/config.py:120 (default HS256). Optional.
# ALGORITHM=HS256
# JWT lifetime in minutes. Read at apps/api/app/config.py:121 (default 30). Optional.
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# Set to 1 by Vercel at runtime; do not set it yourself. Read at api/index.py:45 and apps/api/app/database.py:22.
# VERCEL=

# Frontend dev only: set to true to load the axe accessibility checker in dev. Read at apps/web/src/main.tsx:19. Optional.
VITE_ENABLE_AXE=
